# Copy to .env and fill in real values: cp .example.env .env
# docker compose, `make` and `source .env` all read it.
export POSTGRES_USER=kittyface
export POSTGRES_PASSWORD=change-me
export POSTGRES_DB=kittyface
# For the backend, tests and alembic on the host; compose's db service publishes 5433.
export DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}
